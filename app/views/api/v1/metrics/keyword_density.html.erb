<!DOCTYPE html>
<html>
<head>
  <title>Keyword Density Visualization</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; text-align: center; }
    .container { max-width: 800px; margin: 0 auto; }
    .stats { display: flex; justify-content: space-around; margin: 20px 0; }
    .stat-box { padding: 20px; background: #f4f4f9; border-radius: 8px; }

    .charts-container {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 40px;
      margin-top: 30px;
    }
    .chart-wrapper {
      flex: 1;
      min-width: 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Keyword Density for "<%= @request_params[:term] %>"</h2>
    <p>App: <%= @request_params[:app_id] %> | Date: <%= @request_params[:start_date] %> to <%= @request_params[:end_date] %></p>
    
    <div class="stats">
      <div class="stat-box">
        <h3><%= @data[:total_reviews] %></h3>
        <p>Total Reviews</p>
      </div>
      <div class="stat-box">
        <h3><%= @data[:matching_reviews] %></h3>
        <p>Matching Reviews</p>
      </div>
      <div class="stat-box">
        <h3><%= @data[:density_percentage] %>%</h3>
        <p>Density</p>
      </div>
    </div>

    <div class="charts-container">
      <div class="chart-wrapper">
        <h3>Sentiment Distribution</h3>
        <canvas id="densityChart"></canvas>
      </div>
      
      <div class="chart-wrapper">
        <h3>Matched Reviews by Country</h3>
        <canvas id="countryChart"></canvas>
      </div>
    </div>
  </div>

  <script>
    const ctx = document.getElementById('densityChart');
    new Chart(ctx, {
      type: 'pie',
      data: {
        labels: [
          'Positive Reviews',
          'Neutral Reviews',
          'Negative Reviews',
          'Other Reviews'
        ],
        datasets: [{
          data: [
            <%= @data[:rating_distribution][:positive] %>,
            <%= @data[:rating_distribution][:neutral] %>,
            <%= @data[:rating_distribution][:negative] %>,
            <%= (@data[:total_reviews]) - (@data[:matching_reviews]) %>
          ],
          backgroundColor: [
            '#00FF00',
            '#FFCB00',
            '#FF0000',
            '#E0E0E0'
          ]
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });

    const countryCtx = document.getElementById('countryChart');
    const countryData = <%= (@data[:country_distribution] || {}).to_json.html_safe %>;
    new Chart(countryCtx, {
      type: 'bar',
      data: {
        labels: Object.keys(countryData),
        datasets: [{
          label: 'Matched Reviews',
          data: Object.values(countryData),
          backgroundColor: '#2196F3'
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  </script>
</body>
</html>
